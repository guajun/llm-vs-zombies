{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM vs Zombies lifecycle record envelope v1",
  "$id": "lvz.lifecycle-record.v1",
  "type": "object",
  "required": ["schema", "file_seq", "run_id", "branch_id", "session_id", "sequence_domain", "event"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "lvz.lifecycle-record.v1"},
    "file_seq": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "integer", "minimum": 1},
    "sequence_domain": {"const": "lvz.measurement.capture-sequence"},
    "event": {"$ref": "#/$defs/event"}
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["schema", "kind", "capture_sequence", "version", "version_phase", "engine_call_id",
                   "invocation", "entity", "before_after", "classification", "probe", "complete"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "lvz.lifecycle-event.v1"},
        "kind": {"const": "zombie_initialized"},
        "capture_sequence": {"type": "integer", "minimum": 1},
        "version": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["epoch", "tick", "revision"],
              "additionalProperties": false,
              "properties": {
                "epoch": {"type": "integer", "minimum": 0},
                "tick": {"type": "integer", "minimum": 0},
                "revision": {"type": "integer", "minimum": 0}
              }
            }
          ]
        },
        "version_phase": {"enum": ["initialization", "controlled_boundary"]},
        "engine_call_id": {"type": ["integer", "null"], "minimum": 1},
        "invocation": {
          "type": "object",
          "required": ["invocation_id", "depth", "parent_invocation_id"],
          "additionalProperties": false,
          "properties": {
            "invocation_id": {"type": "integer", "minimum": 1},
            "depth": {"type": "integer", "minimum": 0},
            "parent_invocation_id": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "entity": {
          "type": "object",
          "required": ["id", "slot", "generation"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "integer", "minimum": 1},
            "slot": {"type": "integer", "minimum": 0, "maximum": 65535},
            "generation": {"type": "integer", "minimum": 0, "maximum": 65535}
          }
        },
        "before_after": {
          "type": "object",
          "required": ["before", "after"],
          "additionalProperties": false,
          "properties": {
            "before": {"type": "null"},
            "after": {"$ref": "#/$defs/snapshot"}
          }
        },
        "classification": {
          "type": "object",
          "required": ["class", "cause"],
          "additionalProperties": false,
          "properties": {
            "class": {"const": "initialization"},
            "cause": {"const": "unknown"}
          }
        },
        "probe": {
          "type": "object",
          "required": ["name", "schema", "sequence_domain"],
          "additionalProperties": false,
          "properties": {
            "name": {"const": "zombie-initialize-exit"},
            "schema": {"const": "lvz.spawn.v1"},
            "sequence_domain": {"const": "lvz.measurement.capture-sequence"}
          }
        },
        "complete": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"version_phase": {"const": "initialization"}}, "required": ["version_phase"]},
          "then": {"properties": {"version": {"type": "null"}, "engine_call_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"version_phase": {"const": "controlled_boundary"}}, "required": ["version_phase"]},
          "then": {"properties": {"version": {"type": "object"}}}
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "required": ["id", "slot", "generation", "row0", "type", "game_clock"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "slot": {"type": "integer", "minimum": 0, "maximum": 65535},
        "generation": {"type": "integer", "minimum": 0, "maximum": 65535},
        "row0": {"type": "integer"},
        "type": {"type": "integer", "minimum": 0},
        "game_clock": {"type": "integer", "minimum": 0}
      }
    }
  }
}
